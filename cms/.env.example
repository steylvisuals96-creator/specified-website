# Kopieer dit bestand naar .env.local en vul de waarden in.
# Zet dezelfde variabelen in Vercel (Production, Preview én Development).

# --- Verplicht: de app start niet zonder deze twee ---

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://gebruiker:wachtwoord@cluster.mongodb.net/specified-cms

# Ondertekent de sessie-JWT's. Minstens 32 willekeurige tekens, en per omgeving
# een andere. Genereren kan met: openssl rand -base64 32
# Deze waarde wijzigen logt iedereen uit.
PAYLOAD_SECRET=

# --- Mediaopslag (Cloudflare R2) ---
# Ontbreken deze vier, dan schrijft Payload uploads naar de lokale schijf. Op
# Vercel is dat filesystem tijdelijk, dus voor productie zijn ze verplicht.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Inkomende e-mail (Postmark webhook → /api/inbound-email) ---
# Ontbreekt dit secret, dan weigert de route alle inkomende e-mail.
EMAIL_WEBHOOK_SECRET=

# --- Make.com callback (→ /api/make-callback) ---
# Ontbreekt dit secret, dan weigert de route alles. Geeft schrijfrechten op de
# recruitmentcollecties; behandel als een wachtwoord.
MAKE_SECRET=
