# Beheer van Specified. Kopieer naar .env.local en vul in; dezelfde waarden in Vercel.
# Waarden staan nooit in git.

# --- Supabase (project specified-cms, ref htkcrkafetzbnpznektz) ---
NEXT_PUBLIC_SUPABASE_URL=https://htkcrkafetzbnpznektz.supabase.co
# Publishable key (sb_publishable_...): mag in de browser, RLS bewaakt alles.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): alleen op de server, voor gebruikersbeheer en het
# script gebruiker-maken. Supabase-dashboard > Project Settings > API Keys.
SUPABASE_SECRET_KEY=

# --- Cloudflare R2 (dezelfde bucket als de oude CMS, privé) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Website ---
# Voor het live voorbeeld en het meteen verversen na opslaan.
NEXT_PUBLIC_WEBSITE_URL=https://specified-website.vercel.app
# Zelfde waarde als VERVERS_GEHEIM in het Vercel-project van de website.
# Genereren: openssl rand -base64 32
WEBSITE_VERVERS_GEHEIM=

# --- Adres van dit beheer (voor uitnodigingslinks en beeldlinks) ---
NEXT_PUBLIC_BEHEER_URL=http://localhost:3004

# --- Tweestapslogin voor iedereen verplicht (1) of alleen wie hem aanzette (0) ---
MFA_VERPLICHT=0

# --- SEO-bot (zie beheer/README.md) ---
SEO_BOT_ENABLED=0
SEO_BOT_AUTO_METADATA=0
SEO_BOT_IMAGES=0
SEO_SITE_URL=
SEO_GSC_PROPERTY=
SEO_GSC_CLIENT_EMAIL=
# Plaats de letterlijke \\n voor regeleinden in Vercel of gebruik een meerregelige waarde.
SEO_GSC_PRIVATE_KEY=
SEO_APIFY_TOKEN=
SEO_OPENAI_API_KEY=
CRON_SECRET=
